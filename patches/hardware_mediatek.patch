diff --git a/wlan/wpa_supplicant_8_lib/Android.bp b/wlan/wpa_supplicant_8_lib/Android.bp
index 7b81488..8d46f48 100644
--- a/wlan/wpa_supplicant_8_lib/Android.bp
+++ b/wlan/wpa_supplicant_8_lib/Android.bp
@@ -13,10 +13,16 @@ cc_library_static {
     // (struct wpa_supplicant, wpa_global, wpa_ssid), whose layout depends on
     // CONFIG_* flags. Compile it with the flags of the wpa_supplicant binary it
     // is linked into, or it reads fields at the wrong offsets.
-    defaults: ["wpa_supplicant_cflags_default"],
+    // wpa_supplicant_usd_defaults adds -DCONFIG_NAN_USD and -DCONFIG_NAN, both
+    // of which change struct wpa_driver_nl80211_data / i802_bss. With only
+    // CONFIG_NAN_USD the library read drv->first_bss at a stale offset (NULL),
+    // and wpa_supplicant crashed in wpa_driver_mediatek_set_country as soon as
+    // the country code was set, so Wi-Fi never came up.
+    defaults: [
+        "wpa_supplicant_cflags_default",
+        "wpa_supplicant_usd_defaults",
+    ],
     cflags: [
-        // Set by wpa_supplicant_usd_defaults, which also adds sources.
-        "-DCONFIG_NAN_USD",
         "-DCONFIG_MTK_P2P_SIGMA",
         // The shared defaults add -Werror; this imported code is not
         // warning-clean against them.
