diff --git a/wlan/wpa_supplicant_8_lib/mediatek_driver_nl80211.h b/wlan/wpa_supplicant_8_lib/mediatek_driver_nl80211.h
index 877ba4b..292846f 100644
--- a/wlan/wpa_supplicant_8_lib/mediatek_driver_nl80211.h
+++ b/wlan/wpa_supplicant_8_lib/mediatek_driver_nl80211.h
@@ -8,13 +8,13 @@
 
 #include <linux/wireless.h>
 
-#ifndef BITS
+#ifndef MTK_BITS
 /* Eddie */
-/* bits range: for example BITS(16,23) = 0xFF0000
+/* bits range: for example MTK_BITS(16,23) = 0xFF0000
  *   ==>  (BIT(m)-1)   = 0x0000FFFF     ~(BIT(m)-1)   => 0xFFFF0000
  *   ==>  (BIT(n+1)-1) = 0x00FFFFFF
  */
-#define BITS(m, n) (~(BIT(m) - 1) & ((BIT(n) - 1) | BIT(n)))
+#define MTK_BITS(m, n) (~(BIT(m) - 1) & ((BIT(n) - 1) | BIT(n)))
 #endif /* BIT */
 
 #define OUI_MTK 0x000CE7
